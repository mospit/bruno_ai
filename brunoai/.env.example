# Bruno AI Environment Configuration

# Database Configuration
POSTGRES_PASSWORD=bruno_secure_pass_2024
DATABASE_URL=postgresql://bruno_user:bruno_secure_pass_2024@localhost:5432/bruno_ai

# Redis Configuration
REDIS_PASSWORD=redis_secure_pass_2024
REDIS_URL=redis://:redis_secure_pass_2024@localhost:6379

# JWT Configuration
JWT_SECRET=bruno_jwt_secret_key_2024_change_this_in_production

# API Configuration
API_PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://bruno-ai.app

# External API Keys
INSTACART_API_KEY=your_instacart_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Storage Configuration
UPLOAD_MAX_SIZE=10485760
STORAGE_PATH=./uploads

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Production URLs
FRONTEND_URL=https://bruno-ai.app
API_URL=https://api.bruno-ai.app

# Security
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=900000
BCRYPT_ROUNDS=12
