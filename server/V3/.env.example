# Bruno AI V3.1 Server Environment Configuration

# Claude API Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here

# Instacart API Integration
INSTACART_API_KEY=your_instacart_api_key_here
INSTACART_BASE_URL=https://api.instacart.com/v1

# Database Configuration
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/bruno_ai_v3

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=your_jwt_secret_key_here

# Agent Configuration
MAX_BUDGET_DEFAULT=200.0
DEFAULT_FAMILY_SIZE=4
DEFAULT_CUISINE_PREFERENCES=["American", "Italian", "Mexican"]

# Token Management
MAX_TOKENS_PER_REQUEST=8000
CONTEXT_COMPRESSION_THRESHOLD=4000
CACHE_TTL_SECONDS=3600

# A2A Protocol Configuration
A2A_TIMEOUT_SECONDS=30
A2A_RETRY_ATTEMPTS=3
A2A_ENABLE_STREAMING=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/bruno_v3.log

# Performance Configuration
ENABLE_CACHING=true
CACHE_HIT_RATIO_TARGET=0.85
RESPONSE_TIME_TARGET_MS=1200

# Security Configuration
ENABLE_JWT_AUTH=true
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Development Configuration
DEBUG_MODE=false
ENABLE_AGENT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
