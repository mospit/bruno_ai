# Bruno AI Production Environment Configuration
# This file contains production settings for deployment

# Required API Keys (SET THESE IN YOUR DEPLOYMENT ENVIRONMENT)
GEMINI_API_KEY=your_production_gemini_api_key_here
INSTACART_API_KEY=your_production_instacart_api_key_here

# Database Configuration (Production PostgreSQL)
DB_USER=bruno_prod_user
DB_PASSWORD=your_secure_production_password_here
DB_HOST=your_production_db_host
DB_NAME=bruno_prod_db
DB_PORT=5432

# Authentication & Security (GENERATE NEW SECURE KEYS)
JWT_SECRET_KEY=your_production_jwt_secret_key_here
ENCRYPTION_KEY=your_production_encryption_key_here

# Production Configuration
REDIS_URL=redis://your_production_redis_host:6379
A2A_GATEWAY_URL=https://your-domain.com/api/v1
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/bruno_ai_production.log

# Production Settings
DEBUG=false
ENVIRONMENT=production
SSL_ENABLED=true
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# Performance Settings
MAX_WORKERS=4
REQUEST_TIMEOUT=30
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Monitoring & Analytics
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
